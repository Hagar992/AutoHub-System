@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_HeaderAndFooterLayout.cshtml";
}

@section styles {
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/about.css">
}

<!-- Hero Section -->
<section class="about-hero">
    <h1>About AutoHub</h1>
    <p>Your trusted partner in car sales and rentals</p>
</section>

<!-- About Section -->
<section class="about-section">
    <div class="about-content">
        <h2>Who We Are</h2>
        <p>
            We provide a modern platform for buying and renting cars with ease,
            offering a seamless experience without upfront payments.
            Our goal is to connect users with the best deals and trusted dealers.
        </p>
    </div>
</section>

<!-- Mission & Vision -->
<section class="mission-vision">
    <div class="mission-card">
        <div class="icon">🎯</div>
        <h3>Our Mission</h3>
        <p>
            To simplify car sales and rentals by ensuring transparency,
            trust, and convenience for our customers.
        </p>
    </div>
    <div class="mission-card">
        <div class="icon">👁️</div>
        <h3>Our Vision</h3>
        <p>
            To become the leading online car marketplace in the region,
            making vehicle ownership and rentals accessible to everyone.
        </p>
    </div>
</section>

