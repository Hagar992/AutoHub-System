@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_HeaderAndFooterLayout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/assets/css/about.css"  />
}

<!-- About Section -->
<section class="about fade-in">
    <h2>Who We Are</h2>
    <p>
        We provide a modern platform for buying and renting cars with ease, 
        offering a seamless experience without upfront payments. 
        Our goal is to connect users with the best deals and trusted dealers.
    </p>
</section>

<!-- Mission & Vision -->
<section class="mission">
    <div class="card">
        <h3>Our Mission</h3>
        <p>
            To simplify car sales and rentals by ensuring transparency, 
            trust, and convenience for our customers.
        </p>
    </div>
    <div class="card">
        <h3>Our Vision</h3>
        <p>
            To become the leading online car marketplace in the region, 
            making vehicle ownership and rentals accessible to everyone.
        </p>
    </div>
</section>

<section class="team">
    <h2>Meet Our Team</h2>
    <div class="team-container">
        <div class="team-member">
            <img src="https://placehold.co/120x120/0a3d62/ffffff?text=SA" alt="Team Member">
            <h4>Hagar Atia</h4>
            <p>.Net Full Stack Developer</p>
        </div>
        <div class="team-member">
            <img src="https://placehold.co/120x120/0a3d62/ffffff?text=SA" alt="Team Member">
            <h4>Aya </h4>
            <p>.Net Full Stack Developer</p>
        </div>
        <div class="team-member">
            <img src="https://placehold.co/120x120/3c6382/ffffff?text=AB" alt="Team Member">
            <h4>Doha</h4>
            <p>.Net Full Stack Developer</p>
        </div>
        <div class="team-member">
            <img src="https://placehold.co/120x120/e74c3c/ffffff?text=SC" alt="Team Member">
            <h4>Yehia</h4>
            <p>.Net Full Stack Developer</p>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta fade-in">
    <h2>Want to know more?</h2>
    <a asp-controller="Home" asp-action="Contact" class="btn">Contact Us</a>
</section>

@section jscript {
    <script src="~/assets/js/about.js"></script>
}